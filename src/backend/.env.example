# Backend environment variables
# Copy this file to .env and fill in your values — NEVER commit .env

# Database — REQUIRED for PostgreSQL
# Replace USER, PASSWORD, HOST, PORT, DBNAME with your actual values
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/congestiq

# Application
APP_PORT=8000
APP_ENV=development

# CORS — comma-separated allowed origins for the React frontend
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# --- For local development with SQLite (no PostgreSQL needed) ---
# DATABASE_URL=sqlite:///./congestiq_dev.db
